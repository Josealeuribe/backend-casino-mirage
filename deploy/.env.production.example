# Plantilla para .env.production -- copia este archivo a .env.production y
# rellena los valores reales. .env.production NUNCA se commitea (contiene la
# contraseña real de la base de datos de Aiven).
#
# Se usa con docker-compose.prod.yml (produccion real, MySQL de Aiven), no
# con docker-compose.yml (desarrollo local). Ver ese archivo para el detalle
# completo de como levantar cada uno.

# --- Base de datos (Aiven MySQL) --------------------------------------------
#
# Tal cual aparece en "Connection information" del panel de Aiven, con dos
# parametros de Prisma agregados al final para que respete SSL:
#   - sslaccept=strict  -> exige un certificado valido (equivalente al
#     "ssl-mode=REQUIRED" que muestra Aiven), no solo cifra la conexion.
#   - sslcert=aiven-ca.pem -> el certificado CA que Aiven entrega bajo
#     "CA certificate" en esa misma pantalla. Debe guardarse tal cual en
#     backend/prisma/aiven-ca.pem (la ruta se resuelve relativa a esa
#     carpeta) -- no es un secreto, pero SI hace falta para que la conexion
#     funcione.
DATABASE_URL="mysql://avnadmin:TU_PASSWORD_DE_AIVEN@mysql-c02d8d5-innovaclub-8ae8.a.aivencloud.com:15721/defaultdb?sslaccept=strict&sslcert=aiven-ca.pem"

# --- Secretos de la API ------------------------------------------------------
#
# Genera cada uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Distintos de los de backend/.env (desarrollo) y de Casino-cucuta.
JWT_SECRET="generate-with-node-crypto-randomBytes-32-hex"
TICKET_SECRET="generate-a-different-one-the-same-way"

SESSION_TOKEN_TTL=7d
TICKET_TTL_MINUTES=30

# --- Despliegue --------------------------------------------------------------
CORS_ORIGIN=http://localhost:8003
FIGMA_PUBLIC_URL=/arauca
VITE_API_URL=/api
# Puertos DISTINTOS a los del docker-compose.yml de desarrollo (8002/4002) a
# proposito -- asi el stack de produccion puede levantarse a la vez que el de
# desarrollo, sin que ninguno de los dos tenga que apagarse primero.
WEB_BIND=127.0.0.1
WEB_PORT=8003
API_BIND=127.0.0.1
API_PORT=4003
