# Copia a .env si necesitas cambiar algo -- los valores por defecto del
# docker-compose.yml ya funcionan para desplegar detras de innovaclub.com.co.

# Subpath donde vive esta landing dentro de innovaclub.com.co.
FIGMA_PUBLIC_URL=/arauca

# Puerto interno publicado SOLO en localhost -- el Nginx compartido del host
# es la unica puerta de entrada publica.
WEB_BIND=127.0.0.1
WEB_PORT=8002

# --- API real (Express + Prisma) ------------------------------------------
#
# Los secretos de verdad (JWT_SECRET, TICKET_SECRET) NO van aqui: viven en
# backend/.env (nunca se commitea, ver backend/.env.example para generarlos).
# Esto solo cubre lo que decide el despliegue.

# Puerto interno de la API, publicado SOLO en localhost (para curl/Postman en
# desarrollo). El navegador nunca le habla directo: nginx.conf del frontend
# hace proxy de "/api/" hacia el contenedor `api` por la red interna.
API_BIND=127.0.0.1
API_PORT=4002

# Ruta que el frontend usa para hablarle a la API. Con "/api" (por defecto),
# el navegador siempre pega a su propio origen y nginx.conf resuelve el
# proxy -- no hace falta CORS en produccion. Solo cambiarla si el front y la
# API alguna vez se despliegan en dominios distintos.
VITE_API_URL=/api

# Debe coincidir con el origen publico real del sitio (con o sin
# /arauca segun aplique) -- lo usa la API para validar CORS cuando SI hay un
# origen cross-site de por medio (p.ej. en desarrollo local sin el proxy).
CORS_ORIGIN=http://localhost:8002

# --- MySQL local -----------------------------------------------------------
#
# A diferencia de Casino-cucuta (que usa una base gestionada en produccion),
# aqui la base SI es local: la levanta el propio docker-compose.yml.
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=casino_arauca
MYSQL_USER=app_user
MYSQL_PASSWORD=app_pass
# Puerto publicado en localhost -- 3308 y no 3306, para no chocar con un
# MySQL ya instalado en la maquina.
DB_PORT=3308
