# Base de datos local (MySQL, levantada por el servicio `db` del
# docker-compose.yml de la raiz). El host es "db" cuando la API corre dentro
# de Docker, y "localhost" con el puerto publicado si corres la API suelta.
DATABASE_URL="mysql://app_user:app_pass@localhost:3306/casino_arauca"

PORT=4000

# Genera cada uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Nunca reuses los de Casino-cucuta: son proyectos distintos.
JWT_SECRET="generate-with-node-crypto-randomBytes-32-hex"
TICKET_SECRET="generate-a-different-one-the-same-way"

SESSION_TOKEN_TTL="7d"
TICKET_TTL_MINUTES=30

CORS_ORIGIN="http://localhost:8002"
